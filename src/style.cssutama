* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  color: #e5e7eb;
  background: #060912;
}

html {
  background: #060912;
}

body {
  min-width: 320px;
  min-height: 100vh;
  background:
    radial-gradient(
      circle at 80% 0%,
      rgba(37, 99, 235, 0.12),
      transparent 28%
    ),
    radial-gradient(
      circle at 10% 90%,
      rgba(14, 165, 233, 0.06),
      transparent 25%
    ),
    #060912;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

/* =========================================
   APP
========================================= */

.app {
  display: flex;
  min-height: 100vh;
  background: #060912;
}

/* =========================================
   SIDEBAR
========================================= */

.sidebar {
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;

  width: 250px;

  display: flex;
  flex-direction: column;

  padding: 24px 16px;

  background:
    linear-gradient(
      180deg,
      #0a0f1c 0%,
      #080c16 100%
    );

  border-right: 1px solid #182131;

  z-index: 50;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;

  padding: 4px 10px 30px;
}

.brand-logo {
  width: 43px;
  height: 43px;

  display: grid;
  place-items: center;

  border-radius: 12px;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #1d4ed8
    );

  color: white;

  font-size: 21px;
  font-weight: 800;

  box-shadow:
    0 8px 25px
    rgba(37, 99, 235, 0.25);
}

.brand h2 {
  color: #f8fafc;
  font-size: 17px;
  line-height: 1.2;
}

.brand span {
  display: block;

  margin-top: 4px;

  color: #64748b;
  font-size: 10px;
}

/* MENU */

.sidebar-menu {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 12px;

  padding: 12px 14px;

  border-radius: 10px;

  color: #7f8da3;

  font-size: 13px;
  font-weight: 500;

  transition:
    background 0.2s,
    color 0.2s;
}

.menu-item span {
  width: 20px;

  display: grid;
  place-items: center;

  font-size: 17px;
}

.menu-item.active {
  color: #ffffff;

  background:
    linear-gradient(
      90deg,
      rgba(37, 99, 235, 0.22),
      rgba(37, 99, 235, 0.08)
    );

  border: 1px solid
    rgba(37, 99, 235, 0.2);
}

.menu-item:hover {
  color: #ffffff;
  background: #111827;
}

/* SIDEBAR BOTTOM */

.sidebar-bottom {
  margin-top: auto;
}

.system-status {
  display: flex;
  align-items: center;
  gap: 10px;

  padding: 13px;

  border-radius: 10px;

  background: #0d1422;
  border: 1px solid #182436;
}

.system-status strong {
  display: block;

  color: #cbd5e1;

  font-size: 11px;
}

.system-status small {
  display: block;

  margin-top: 3px;

  color: #64748b;

  font-size: 10px;
}

.dot {
  width: 8px;
  height: 8px;

  flex-shrink: 0;

  border-radius: 50%;
}

.dot.online {
  background: #22c55e;

  box-shadow:
    0 0 10px
    rgba(34, 197, 94, 0.7);
}

.dot.offline {
  background: #ef4444;
}

.copyright {
  margin-top: 18px;

  color: #334155;

  font-size: 9px;
  text-align: center;
}

/* =========================================
   MAIN
========================================= */

.main {
  width: calc(100% - 250px);

  margin-left: 250px;

  min-height: 100vh;

  padding: 32px;

  overflow: hidden;
}

/* =========================================
   TOPBAR
========================================= */

.topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 30px;
}

.breadcrumb {
  margin-bottom: 8px;

  color: #3b82f6;

  font-size: 11px;
  font-weight: 600;

  text-transform: uppercase;
  letter-spacing: 1px;
}

.topbar h1 {
  color: #f8fafc;

  font-size: 28px;
  font-weight: 700;

  letter-spacing: -0.5px;
}

.topbar p {
  margin-top: 7px;

  color: #64748b;

  font-size: 13px;
}

.refresh-button {
  display: flex;
  align-items: center;
  gap: 8px;

  padding: 10px 15px;

  border-radius: 9px;

  border: 1px solid #253247;

  background: #0d1422;

  color: #cbd5e1;

  font-size: 12px;
  font-weight: 600;

  transition: 0.2s;
}

.refresh-button:hover {
  background: #131d2e;
  border-color: #334155;
}

.refresh-button span {
  font-size: 17px;
}

/* =========================================
   STATUS CARDS
========================================= */

.status-grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 16px;

  margin-bottom: 20px;
}

.status-card {
  padding: 20px;

  border-radius: 15px;

  background:
    linear-gradient(
      145deg,
      #0c1321,
      #090f1a
    );

  border: 1px solid #1a2637;

  box-shadow:
    0 12px 35px
    rgba(0, 0, 0, 0.16);
}

.status-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.label {
  color: #64748b;

  font-size: 10px;
  font-weight: 700;

  letter-spacing: 1px;
}

.status-card h3 {
  margin-top: 10px;

  color: #f1f5f9;

  font-size: 21px;
}

.status-icon {
  width: 38px;
  height: 38px;

  display: grid;
  place-items: center;

  border-radius: 10px;

  font-size: 15px;
}

.status-icon.green {
  color: #4ade80;
  background: rgba(34, 197, 94, 0.1);
}

.status-icon.red {
  color: #f87171;
  background: rgba(239, 68, 68, 0.1);
}

.status-icon.orange {
  color: #fb923c;
  background: rgba(249, 115, 22, 0.1);
}

.status-icon.blue {
  color: #60a5fa;
  background: rgba(37, 99, 235, 0.1);
}

.connection {
  display: flex;
  align-items: center;
  gap: 7px;

  margin-top: 18px;

  font-size: 10px;
  font-weight: 700;

  letter-spacing: 0.5px;
}

.connection span {
  width: 6px;
  height: 6px;

  border-radius: 50%;
}

.connection.online {
  color: #4ade80;
}

.connection.online span {
  background: #22c55e;

  box-shadow:
    0 0 8px
    rgba(34, 197, 94, 0.7);
}

.connection.offline {
  color: #f87171;
}

.connection.offline span {
  background: #ef4444;
}

.connection.waiting {
  color: #fb923c;
}

.connection.waiting span {
  background: #f97316;
}

.connection.neutral {
  color: #64748b;
}

.connection.neutral span {
  background: #64748b;
}

/* =========================================
   CONTENT CARD
========================================= */

.content-card {
  margin-top: 20px;

  padding: 24px;

  border-radius: 15px;

  background:
    linear-gradient(
      145deg,
      #0c1321,
      #090f1a
    );

  border: 1px solid #1a2637;

  box-shadow:
    0 12px 35px
    rgba(0, 0, 0, 0.16);
}

.section-heading {
  margin-bottom: 24px;
}

.section-heading > div:first-child {
  display: flex;
  align-items: flex-start;
  gap: 13px;
}

.section-number {
  width: 28px;
  height: 28px;

  display: grid;
  place-items: center;

  flex-shrink: 0;

  border-radius: 8px;

  color: #60a5fa;

  background: rgba(
    37,
    99,
    235,
    0.12
  );

  font-size: 10px;
  font-weight: 700;
}

.section-heading h2 {
  color: #f1f5f9;

  font-size: 17px;
}

.section-heading p {
  margin-top: 5px;

  color: #64748b;

  font-size: 12px;
  line-height: 1.5;
}

/* =========================================
   PAIRING FORM
========================================= */

.pairing-form {
  display: flex;
  gap: 10px;
}

.input-wrapper {
  flex: 1;

  display: flex;
  align-items: center;

  min-width: 0;

  padding: 0 15px;

  border-radius: 10px;

  background: #070c15;

  border: 1px solid #263448;

  transition: border 0.2s;
}

.input-wrapper:focus-within {
  border-color: #2563eb;

  box-shadow:
    0 0 0 3px
    rgba(37, 99, 235, 0.08);
}

.input-wrapper span {
  padding-right: 10px;

  color: #64748b;

  font-size: 13px;
  font-weight: 600;

  border-right: 1px solid #263448;
}

.input-wrapper input {
  width: 100%;

  padding: 13px 0 13px 12px;

  border: none;
  outline: none;

  background: transparent;

  color: #f8fafc;

  font-size: 13px;
}

.input-wrapper input::placeholder {
  color: #475569;
}

.pair-button {
  display: flex;
  align-items: center;
  justify-content: center;

  gap: 12px;

  min-width: 190px;

  padding: 13px 20px;

  border: none;

  border-radius: 10px;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #1d4ed8
    );

  color: white;

  font-size: 12px;
  font-weight: 700;

  box-shadow:
    0 8px 20px
    rgba(37, 99, 235, 0.2);

  transition:
    transform 0.2s,
    box-shadow 0.2s;
}

.pair-button:hover:not(:disabled) {
  transform: translateY(-1px);

  box-shadow:
    0 12px 25px
    rgba(37, 99, 235, 0.3);
}

.pair-button span {
  font-size: 18px;
}

/* SPINNER */

.spinner {
  width: 14px;
  height: 14px;

  border: 2px solid
    rgba(255, 255, 255, 0.3);

  border-top-color: white;

  border-radius: 50%;

  animation:
    spin 0.7s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* =========================================
   MESSAGE
========================================= */

.message-box {
  display: flex;
  align-items: center;
  gap: 8px;

  margin-top: 15px;

  padding: 11px 13px;

  border-radius: 9px;

  background: #0b1320;

  border: 1px solid #18263a;

  color: #94a3b8;

  font-size: 11px;
}

.message-box span {
  color: #3b82f6;

  font-size: 8px;
}

/* =========================================
   PAIRING RESULT
========================================= */

.pairing-result {
  margin-top: 20px;

  padding: 24px;

  border-radius: 13px;

  background:
    linear-gradient(
      145deg,
      rgba(5, 46, 22, 0.4),
      rgba(6, 30, 20, 0.2)
    );

  border: 1px solid
    rgba(34, 197, 94, 0.25);

  text-align: center;
}

.pairing-result-top {
  display: flex;
  align-items: center;
  justify-content: space-between;

  text-align: left;
}

.success-label {
  color: #4ade80;

  font-size: 9px;
  font-weight: 800;

  letter-spacing: 1.5px;
}

.pairing-result h3 {
  margin-top: 6px;

  color: #d1fae5;

  font-size: 14px;
}

.success-check {
  width: 34px;
  height: 34px;

  display: grid;
  place-items: center;

  border-radius: 50%;

  background: rgba(34, 197, 94, 0.15);

  color: #4ade80;

  font-weight: 700;
}

.pairing-code {
  margin: 22px 0;

  color: #ffffff;

  font-size: 32px;
  font-weight: 800;

  letter-spacing: 8px;

  word-break: break-all;
}

.copy-button {
  padding: 11px 20px;

  border: 1px solid
    rgba(74, 222, 128, 0.3);

  border-radius: 9px;

  background:
    rgba(34, 197, 94, 0.1);

  color: #86efac;

  font-size: 12px;
  font-weight: 700;

  transition: 0.2s;
}

.copy-button:hover {
  background:
    rgba(34, 197, 94, 0.2);
}

.copy-button.copied {
  background: #15803d;

  border-color: #16a34a;

  color: white;
}

.pairing-result > p {
  margin-top: 15px;

  color: #6ee7b7;

  font-size: 10px;
}

/* =========================================
   SESSION HEADER
========================================= */

.session-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.session-total {
  display: flex;
  align-items: baseline;
  gap: 5px;

  color: #60a5fa;

  font-size: 22px;
  font-weight: 700;
}

.session-total span {
  color: #64748b;

  font-size: 10px;
  font-weight: 500;
}

/* =========================================
   EMPTY STATE
========================================= */

.empty-state {
  padding: 45px 20px;

  text-align: center;

  border-radius: 11px;

  background: rgba(
    7,
    12,
    21,
    0.6
  );

  border: 1px dashed #1e2b3d;
}

.empty-icon {
  width: 48px;
  height: 48px;

  display: grid;
  place-items: center;

  margin: auto;

  border-radius: 50%;

  background: #111827;

  color: #475569;

  font-size: 18px;
}

.empty-state h3 {
  margin-top: 14px;

  color: #cbd5e1;

  font-size: 14px;
}

.empty-state p {
  margin-top: 6px;

  color: #475569;

  font-size: 11px;
}

/* =========================================
   SESSION LIST
========================================= */

.session-list {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.session-item {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;

  padding: 14px;

  border-radius: 11px;

  background: #080e19;

  border: 1px solid #172336;

  transition: border 0.2s;
}

.session-item:hover {
  border-color: #263a55;
}

.session-left {
  display: flex;
  align-items: center;
  gap: 12px;

  min-width: 0;
}

.session-avatar {
  width: 40px;
  height: 40px;

  display: grid;
  place-items: center;

  flex-shrink: 0;

  border-radius: 11px;

  background:
    linear-gradient(
      135deg,
      #1d4ed8,
      #2563eb
    );

  color: white;

  font-size: 14px;
  font-weight: 800;
}

.session-left h3 {
  color: #e2e8f0;

  font-size: 13px;
}

.session-left p {
  margin-top: 4px;

  color: #64748b;

  font-size: 11px;

  letter-spacing: 1px;
}

.session-right {
  display: flex;
  align-items: center;
  gap: 10px;
}

.session-badge {
  display: flex;
  align-items: center;
  gap: 6px;

  padding: 6px 9px;

  border-radius: 7px;

  font-size: 10px;
  font-weight: 600;
}

.session-badge span {
  width: 5px;
  height: 5px;

  border-radius: 50%;
}

.session-badge.connected {
  color: #4ade80;

  background:
    rgba(34, 197, 94, 0.08);
}

.session-badge.connected span {
  background: #22c55e;
}

.session-badge.disconnected {
  color: #f87171;

  background:
    rgba(239, 68, 68, 0.08);
}

.session-badge.disconnected span {
  background: #ef4444;
}

.logout-button {
  padding: 7px 11px;

  border-radius: 7px;

  border: 1px solid
    rgba(239, 68, 68, 0.25);

  background:
    rgba(239, 68, 68, 0.06);

  color: #f87171;

  font-size: 10px;
  font-weight: 600;
}

.logout-button:hover {
  background:
    rgba(239, 68, 68, 0.14);
}

/* =========================================
   FOOTER
========================================= */

.footer {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 24px 4px;

  color: #334155;

  font-size: 10px;
}

/* =========================================
   MODAL
========================================= */

.modal-overlay {
  position: fixed;

  inset: 0;

  z-index: 9999;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 20px;

  background:
    rgba(0, 0, 0, 0.75);

  backdrop-filter:
    blur(8px);
}

.logout-modal {
  position: relative;

  width: 100%;
  max-width: 420px;

  padding: 28px;

  border-radius: 17px;

  background:
    linear-gradient(
      145deg,
      #0d1524,
      #080e18
    );

  border: 1px solid #243249;

  box-shadow:
    0 30px 80px
    rgba(0, 0, 0, 0.65);
}

.close-modal {
  position: absolute;

  top: 12px;
  right: 15px;

  width: 30px;
  height: 30px;

  border: none;

  border-radius: 8px;

  background: transparent;

  color: #64748b;

  font-size: 22px;
}

.close-modal:hover {
  color: #f8fafc;
  background: #172033;
}

.warning-icon {
  width: 42px;
  height: 42px;

  display: grid;
  place-items: center;

  margin-bottom: 16px;

  border-radius: 11px;

  background:
    rgba(239, 68, 68, 0.1);

  color: #f87171;

  font-size: 20px;
  font-weight: 800;
}

.logout-modal h2 {
  color: #f8fafc;

  font-size: 19px;
}

.logout-modal > p {
  margin-top: 7px;

  color: #64748b;

  font-size: 12px;

  line-height: 1.6;
}

.target-session {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin: 18px 0 12px;

  padding: 12px;

  border-radius: 9px;

  background: #080e18;

  border: 1px solid #1d2a3d;
}

.target-session span {
  color: #64748b;

  font-size: 9px;
  font-weight: 700;

  letter-spacing: 1px;
}

.target-session strong {
  color: #cbd5e1;

  font-size: 12px;

  letter-spacing: 2px;
}

.logout-modal input {
  width: 100%;

  padding: 13px;

  border-radius: 9px;

  border: 1px solid #29384e;

  outline: none;

  background: #070c15;

  color: #f8fafc;

  font-size: 13px;
}

.logout-modal input:focus {
  border-color: #2563eb;
}

.logout-modal input::placeholder {
  color: #475569;
}

.modal-message {
  margin-top: 10px;

  padding: 10px;

  border-radius: 8px;

  background:
    rgba(239, 68, 68, 0.08);

  color: #f87171;

  font-size: 11px;
}

.modal-buttons {
  display: flex;
  gap: 9px;

  margin-top: 16px;
}

.modal-buttons button {
  flex: 1;

  padding: 12px;

  border-radius: 9px;

  font-size: 11px;
  font-weight: 700;
}

.cancel-button {
  border: 1px solid #29384e;

  background: #111827;

  color: #94a3b8;
}

.cancel-button:hover {
  background: #172033;
}

.confirm-button {
  border: 1px solid #dc2626;

  background: #dc2626;

  color: white;
}

.confirm-button:hover {
  background: #b91c1c;
}

/* =========================================
   RESPONSIVE TABLET
========================================= */

@media (max-width: 1000px) {

  .status-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .status-card:last-child {
    grid-column: span 2;
  }

}

/* =========================================
   RESPONSIVE MOBILE
========================================= */

@media (max-width: 760px) {

  .sidebar {
    position: fixed;

    width: 64px;

    padding: 20px 8px;
  }

  .brand {
    justify-content: center;

    padding:
      4px 0 25px;
  }

  .brand > div:last-child {
    display: none;
  }

  .brand-logo {
    width: 42px;
    height: 42px;
  }

  .menu-item {
    justify-content: center;

    padding: 12px 8px;
  }

  .menu-item span {
    width: auto;
  }

  .menu-item {
    font-size: 0;
  }

  .sidebar-bottom {
    display: none;
  }

  .main {
    width: calc(100% - 64px);

    margin-left: 64px;

    padding: 22px 16px;
  }

  .topbar h1 {
    font-size: 23px;
  }

  .topbar p {
    font-size: 11px;
  }

  .refresh-button {
    padding: 9px 11px;
  }

  .refresh-button span {
    font-size: 15px;
  }

  .status-grid {
    grid-template-columns: 1fr;
  }

  .status-card:last-child {
    grid-column: auto;
  }

  .content-card {
    padding: 18px;
  }

}

/* =========================================
   SMALL MOBILE
========================================= */

@media (max-width: 560px) {

  .topbar {
    align-items: flex-start;
  }

  .refresh-button {
    font-size: 0;
  }

  .refresh-button span {
    font-size: 19px;
  }

  .pairing-form {
    flex-direction: column;
  }

  .pair-button {
    width: 100%;
  }

  .pairing-code {
    font-size: 25px;

    letter-spacing: 5px;
  }

  .pairing-result {
    padding: 20px 15px;
  }

  .session-item {
    align-items: flex-start;

    flex-direction: column;
  }

  .session-right {
    width: 100%;

    justify-content: space-between;
  }

  .session-badge {
    flex: 1;

    justify-content: center;
  }

  .logout-button {
    padding:
      8px 15px;
  }

  .footer {
    flex-direction: column;

    align-items: flex-start;

    gap: 7px;
  }

  .logout-modal {
    padding: 22px 18px;
  }

}

/* =========================================
   VERY SMALL SCREEN
========================================= */

@media (max-width: 380px) {

  .main {
    padding: 18px 12px;
  }

  .topbar h1 {
    font-size: 20px;
  }

  .content-card {
    padding: 15px;
  }

  .pairing-code {
    font-size: 21px;

    letter-spacing: 3px;
  }

}
