* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --bg: #070b12;
  --card: rgba(15, 21, 32, 0.88);
  --card2: #111927;
  --text: #f5f7fb;
  --muted: #8993a5;
  --border: rgba(255, 255, 255, 0.08);
  --green: #20e58a;
  --blue: #4d8dff;
  --red: #ff5252;
}

body {
  font-family:
    Inter,
    Arial,
    Helvetica,
    sans-serif;

  background:
    radial-gradient(
      circle at 15% 10%,
      rgba(0, 119, 255, 0.13),
      transparent 28%
    ),
    radial-gradient(
      circle at 90% 80%,
      rgba(0, 255, 170, 0.08),
      transparent 25%
    ),
    var(--bg);

  color: var(--text);
  min-height: 100vh;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.5;
}

/* =========================
   PARTICLES
========================= */

.particles {
  position: fixed;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}

.particles span {
  position: absolute;

  width: 3px;
  height: 3px;

  border-radius: 50%;

  background: #ffffff;

  opacity: 0.25;

  animation:
    floatParticle 7s infinite ease-in-out;
}

@keyframes floatParticle {

  0% {
    transform:
      translateY(0)
      scale(1);

    opacity: 0.1;
  }

  50% {
    transform:
      translateY(-50px)
      scale(1.5);

    opacity: 0.5;
  }

  100% {
    transform:
      translateY(0)
      scale(1);

    opacity: 0.1;
  }

}

/* =========================
   APP
========================= */

.app {
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

/* =========================
   SIDEBAR
========================= */

.sidebar {
  position: fixed;

  left: 0;
  top: 0;
  bottom: 0;

  width: 240px;

  padding: 25px 18px;

  background:
    rgba(7, 11, 18, 0.92);

  border-right:
    1px solid var(--border);

  backdrop-filter:
    blur(20px);

  display: flex;
  flex-direction: column;

  z-index: 100;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;

  padding: 8px;
  margin-bottom: 40px;
}

.brand-logo {
  width: 44px;
  height: 44px;

  border-radius: 14px;

  display: flex;
  align-items: center;
  justify-content: center;

  background:
    linear-gradient(
      135deg,
      #ffffff,
      #7d8cff
    );

  color: #05070c;

  font-size: 22px;
  font-weight: 900;

  box-shadow:
    0 0 30px
    rgba(125, 140, 255, 0.3);
}

.brand h2 {
  font-size: 17px;
}

.brand span {
  color: var(--muted);
  font-size: 10px;
}

.sidebar nav {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.nav-item {
  width: 100%;

  border: none;

  background: transparent;

  color: var(--muted);

  padding: 14px;

  border-radius: 12px;

  text-align: left;

  display: flex;
  align-items: center;

  gap: 12px;

  transition: 0.2s;
}

.nav-item span {
  width: 25px;

  text-align: center;

  font-weight: bold;
}

.nav-item:hover {
  background:
    rgba(255, 255, 255, 0.05);

  color: white;
}

.nav-item.active {
  background:
    linear-gradient(
      135deg,
      rgba(77, 141, 255, 0.2),
      rgba(32, 229, 138, 0.08)
    );

  color: white;

  border:
    1px solid
    rgba(77, 141, 255, 0.2);
}

.sidebar-bottom {
  margin-top: auto;
}

.server-status {
  display: flex;
  align-items: center;
  gap: 10px;

  padding: 13px;

  background:
    rgba(255, 255, 255, 0.03);

  border:
    1px solid var(--border);

  border-radius: 12px;

  margin-bottom: 18px;
}

.status-dot {
  width: 9px;
  height: 9px;

  border-radius: 50%;
}

.status-dot.online {
  background: var(--green);

  box-shadow:
    0 0 12px var(--green);
}

.status-dot.offline {
  background: var(--red);
}

.server-status strong,
.server-status small {
  display: block;
}

.server-status strong {
  font-size: 11px;
}

.server-status small {
  color: var(--muted);
  font-size: 10px;
  margin-top: 3px;
}

.sidebar-bottom p {
  color: #555f70;
  font-size: 10px;
  text-align: center;
}

/* =========================
   MAIN
========================= */

.main {
  margin-left: 240px;

  min-height: 100vh;

  padding:
    35px
    45px;

  max-width: 1500px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;

  margin-bottom: 30px;
}

.eyebrow {
  color: #657187;

  font-size: 10px;

  font-weight: 800;

  letter-spacing: 1.5px;
}

.topbar h1 {
  font-size: 32px;

  margin-top: 8px;
}

.topbar p {
  color: var(--muted);

  font-size: 13px;

  margin-top: 7px;
}

.refresh-button {
  background:
    rgba(255, 255, 255, 0.05);

  border:
    1px solid var(--border);

  color: white;

  padding:
    11px 16px;

  border-radius: 10px;

  transition: 0.2s;
}

.refresh-button:hover {
  background:
    rgba(255, 255, 255, 0.1);
}

/* =========================
   STATS
========================= */

.stats-grid {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 15px;

  margin-bottom: 18px;
}

.stat-card {
  background:
    var(--card);

  border:
    1px solid var(--border);

  border-radius: 18px;

  padding: 22px;

  display: flex;

  align-items: center;

  gap: 15px;

  backdrop-filter:
    blur(15px);
}

.stat-icon {
  width: 48px;
  height: 48px;

  border-radius: 14px;

  display: flex;

  align-items: center;
  justify-content: center;

  background:
    rgba(77, 141, 255, 0.12);

  color: var(--blue);

  font-weight: 900;

  font-size: 20px;
}

.stat-icon.whatsapp {
  background:
    rgba(32, 229, 138, 0.1);

  color: var(--green);
}

.stat-icon.blue {
  background:
    rgba(125, 140, 255, 0.1);

  color: #8794ff;
}

.stat-card span {
  color: #6f7a8d;

  font-size: 9px;

  font-weight: bold;

  letter-spacing: 1px;
}

.stat-card h3 {
  font-size: 19px;

  margin: 4px 0;
}

.stat-card small {
  font-size: 9px;
}

.text-online {
  color: var(--green);
}

.text-offline {
  color: var(--red);
}

.text-waiting {
  color: #ffb84d;
}

/* =========================
   CARD
========================= */

.content-card {
  background:
    var(--card);

  border:
    1px solid var(--border);

  border-radius: 20px;

  padding: 28px;

  backdrop-filter:
    blur(15px);
}

.section-header {
  display: flex;

  gap: 15px;

  align-items: flex-start;

  margin-bottom: 25px;
}

.section-number {
  width: 36px;
  height: 36px;

  border-radius: 10px;

  background:
    rgba(77, 141, 255, 0.1);

  color: var(--blue);

  display: flex;

  align-items: center;
  justify-content: center;

  font-size: 11px;

  font-weight: bold;
}

.section-header h2 {
  margin-top: 5px;

  font-size: 21px;
}

.section-header p {
  color: var(--muted);

  font-size: 12px;

  margin-top: 6px;
}

/* =========================
   PAIRING FORM
========================= */

.pairing-form {
  display: grid;

  grid-template-columns:
    1fr
    190px;

  gap: 12px;
}

.phone-input {
  display: flex;

  background:
    rgba(255, 255, 255, 0.035);

  border:
    1px solid var(--border);

  border-radius: 12px;

  overflow: hidden;
}

.country-code {
  padding:
    14px 16px;

  color: var(--muted);

  border-right:
    1px solid var(--border);
}

.phone-input input {
  width: 100%;

  background: transparent;

  border: none;

  outline: none;

  color: white;

  padding:
    14px;

  font-size: 13px;
}

.pair-button {
  border: none;

  border-radius: 12px;

  background:
    linear-gradient(
      135deg,
      #ffffff,
      #aab5ff
    );

  color: #080b12;

  font-weight: 800;

  transition: 0.2s;
}

.pair-button:hover {
  transform:
    translateY(-2px);

  box-shadow:
    0 10px 30px
    rgba(125, 140, 255, 0.2);
}

.pair-button span {
  margin-left: 10px;
}

.spinner {
  display: inline-block;

  width: 13px;
  height: 13px;

  border:
    2px solid
    rgba(0, 0, 0, 0.2);

  border-top-color:
    #000;

  border-radius: 50%;

  animation:
    spin 0.7s linear infinite;

  margin-right: 7px;
}

@keyframes spin {
  to {
    transform:
      rotate(360deg);
  }
}

/* =========================
   MESSAGE
========================= */

.message-box,
.warning-box {
  margin-top: 15px;

  padding: 13px 15px;

  border-radius: 10px;

  font-size: 11px;

  display: flex;

  gap: 10px;

  align-items: center;
}

.message-box {
  background:
    rgba(77, 141, 255, 0.07);

  border:
    1px solid
    rgba(77, 141, 255, 0.12);

  color: #aebcff;
}

.warning-box {
  background:
    rgba(255, 184, 77, 0.08);

  color: #ffc56e;
}

/* =========================
   PAIRING RESULT
========================= */

.pairing-result {
  margin-top: 20px;

  padding: 22px;

  border-radius: 17px;

  background:
    linear-gradient(
      135deg,
      rgba(32, 229, 138, 0.06),
      rgba(77, 141, 255, 0.05)
    );

  border:
    1px solid
    rgba(32, 229, 138, 0.15);
}

.result-header {
  display: flex;

  justify-content: space-between;

  gap: 20px;
}

.success-label {
  color: var(--green);

  font-size: 9px;

  font-weight: bold;

  letter-spacing: 1px;
}

.result-header h3 {
  margin-top: 7px;

  font-size: 18px;
}

.result-header p {
  color: var(--muted);

  font-size: 11px;

  margin-top: 7px;
}

.success-icon {
  width: 40px;
  height: 40px;

  border-radius: 50%;

  background:
    rgba(32, 229, 138, 0.1);

  color: var(--green);

  display: flex;

  align-items: center;
  justify-content: center;
}

.code-container {
  margin-top: 20px;

  background:
    rgba(0, 0, 0, 0.25);

  border:
    1px solid var(--border);

  padding: 15px;

  border-radius: 12px;
}

.code-label {
  color: #687488;

  font-size: 9px;

  font-weight: bold;

  margin-bottom: 10px;
}

.code-row {
  display: flex;

  align-items: center;

  gap: 10px;
}

.pairing-code {
  flex: 1;

  color: white;

  font-size: 22px;

  font-weight: 900;

  letter-spacing: 5px;

  word-break: break-all;
}

.copy-button {
  padding:
    10px 15px;

  border: none;

  border-radius: 9px;

  background:
    #ffffff;

  color: #090c12;

  font-size: 11px;

  font-weight: bold;
}

.copy-button.copied {
  background:
    var(--green);

  color: #00150b;
}

.code-info {
  margin-top: 15px;

  display: flex;

  justify-content: space-between;

  color: var(--muted);

  font-size: 10px;
}

.code-info strong {
  color: white;
}

/* =========================
   SESSIONS
========================= */

.sessions-header {
  display: flex;

  justify-content: space-between;

  align-items: center;

  margin-bottom: 25px;
}

.sessions-header h2 {
  margin-top: 6px;

  font-size: 22px;
}

.sessions-header p {
  color: var(--muted);

  font-size: 12px;

  margin-top: 5px;
}

.session-counter {
  text-align: center;

  padding:
    12px 20px;

  border-radius: 12px;

  background:
    rgba(77, 141, 255, 0.08);
}

.session-counter strong {
  display: block;

  font-size: 24px;

  color: var(--blue);
}

.session-counter span {
  color: var(--muted);

  font-size: 9px;
}

.session-list {
  display: flex;

  flex-direction: column;

  gap: 10px;
}

.session-item {
  display: flex;

  justify-content: space-between;

  align-items: center;

  padding: 15px;

  border:
    1px solid var(--border);

  border-radius: 14px;

  background:
    rgba(255, 255, 255, 0.025);
}

.session-left {
  display: flex;

  align-items: center;

  gap: 12px;
}

.session-avatar {
  width: 42px;
  height: 42px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 12px;

  background:
    rgba(32, 229, 138, 0.1);

  color: var(--green);

  font-weight: bold;
}

.session-left h3 {
  font-size: 13px;
}

.session-left p {
  color: var(--muted);

  font-size: 11px;

  margin-top: 4px;
}

.session-right {
  display: flex;

  align-items: center;

  gap: 12px;
}

.session-badge {
  display: flex;

  align-items: center;

  gap: 6px;

  font-size: 10px;
}

.session-badge > span {
  width: 6px;
  height: 6px;

  border-radius: 50%;
}

.session-badge.online {
  color: var(--green);
}

.session-badge.online > span {
  background:
    var(--green);
}

.session-badge.offline {
  color: var(--red);
}

.session-badge.offline > span {
  background:
    var(--red);
}

.logout-button {
  border: none;

  background:
    rgba(255, 82, 82, 0.1);

  color: var(--red);

  padding:
    8px 12px;

  border-radius: 8px;

  font-size: 10px;
}

/* =========================
   EMPTY
========================= */

.empty-state {
  text-align: center;

  padding:
    60px 20px;
}

.empty-icon {
  width: 55px;
  height: 55px;

  margin:
    0 auto 15px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 15px;

  background:
    rgba(255, 255, 255, 0.05);

  color: var(--muted);

  font-size: 22px;

  font-weight: bold;
}

.empty-state h3 {
  font-size: 16px;
}

.empty-state p {
  color: var(--muted);

  font-size: 12px;

  margin-top: 7px;
}

.empty-button {
  margin-top: 20px;

  border: none;

  background:
    #ffffff;

  color: #05070b;

  padding:
    11px 17px;

  border-radius: 9px;

  font-size: 11px;

  font-weight: bold;
}

/* =========================
   FOOTER
========================= */

.footer {
  display: flex;

  justify-content: space-between;

  margin-top: 20px;

  color: #566174;

  font-size: 9px;
}

/* =========================
   MODAL
========================= */

.modal-overlay {
  position: fixed;

  inset: 0;

  background:
    rgba(0, 0, 0, 0.7);

  backdrop-filter:
    blur(8px);

  display: flex;

  align-items: center;
  justify-content: center;

  padding: 20px;

  z-index: 9999;
}

.logout-modal {
  width: 100%;

  max-width: 400px;

  background:
    #0e1521;

  border:
    1px solid var(--border);

  border-radius: 20px;

  padding: 25px;

  position: relative;

  box-shadow:
    0 30px 80px
    rgba(0, 0, 0, 0.5);
}

.modal-close {
  position: absolute;

  right: 15px;
  top: 15px;

  border: none;

  background: transparent;

  color: var(--muted);

  font-size: 22px;
}

.warning-icon {
  width: 45px;
  height: 45px;

  border-radius: 14px;

  display: flex;

  align-items: center;
  justify-content: center;

  background:
    rgba(255, 82, 82, 0.1);

  color: var(--red);

  font-weight: bold;

  font-size: 20px;

  margin-bottom: 15px;
}

.logout-modal h2 {
  font-size: 20px;
}

.logout-modal > p {
  color: var(--muted);

  font-size: 12px;

  line-height: 1.6;

  margin-top: 7px;
}

.target-session {
  margin-top: 15px;

  padding: 13px;

  background:
    rgba(255, 255, 255, 0.04);

  border-radius: 10px;
}

.target-session span {
  display: block;

  color: var(--muted);

  font-size: 9px;
}

.target-session strong {
  display: block;

  margin-top: 5px;
}

.logout-input {
  width: 100%;

  margin-top: 12px;

  padding: 13px;

  background:
    rgba(255, 255, 255, 0.04);

  border:
    1px solid var(--border);

  border-radius: 10px;

  outline: none;

  color: white;
}

.modal-message {
  margin-top: 10px;

  color: var(--red);

  font-size: 11px;
}

.modal-buttons {
  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 10px;

  margin-top: 15px;
}

.cancel-button,
.confirm-button {
  padding: 12px;

  border: none;

  border-radius: 10px;

  font-weight: bold;

  font-size: 11px;
}

.cancel-button {
  background:
    rgba(255, 255, 255, 0.07);

  color: white;
}

.confirm-button {
  background:
    var(--red);

  color: white;
}

/* =========================
   MOBILE
========================= */

@media (max-width: 850px) {

  .sidebar {
    position: fixed;

    top: auto;
    bottom: 12px;

    left: 50%;

    transform:
      translateX(-50%);

    width:
      calc(100% - 24px);

    height: 65px;

    padding: 7px;

    border:
      1px solid var(--border);

    border-radius: 18px;

    flex-direction: row;

    align-items: center;

    backdrop-filter:
      blur(20px);
  }

  .brand,
  .sidebar-bottom {
    display: none;
  }

  .sidebar nav {
    width: 100%;

    flex-direction: row;

    gap: 5px;
  }

  .nav-item {
    justify-content: center;

    text-align: center;

    flex-direction: column;

    gap: 2px;

    padding: 8px;

    font-size: 9px;
  }

  .nav-item span {
    width: auto;

    font-size: 16px;
  }

  .main {
    margin-left: 0;

    padding:
      25px 15px 100px;
  }

  .stats-grid {
    grid-template-columns: 1fr;
  }

  .pairing-form {
    grid-template-columns: 1fr;
  }

}

@media (max-width: 600px) {

  .topbar {
    align-items: flex-start;

    gap: 15px;

    flex-direction: column;
  }

  .topbar h1 {
    font-size: 27px;
  }

  .content-card {
    padding: 20px;
  }

  .sessions-header {
    align-items: flex-start;

    gap: 15px;
  }

  .session-item {
    align-items: flex-start;

    gap: 15px;

    flex-direction: column;
  }

  .session-right {
    width: 100%;

    justify-content: space-between;
  }

  .code-row {
    flex-direction: column;

    align-items: stretch;
  }

  .pairing-code {
    font-size: 18px;

    text-align: center;

    letter-spacing: 3px;
  }

  .copy-button {
    width: 100%;
  }

  .footer {
    flex-direction: column;

    gap: 7px;
  }

}
