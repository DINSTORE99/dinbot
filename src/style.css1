@import url(
  "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
);

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  font-family:
    "Inter",
    Arial,
    sans-serif;

  color: #f5f7fb;

  background: #080a0f;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;

  background:
    radial-gradient(
      circle at top right,
      rgba(54, 94, 255, 0.12),
      transparent 30%
    ),
    #080a0f;
}

button,
input {
  font-family: inherit;
}

button {
  border: 0;
  cursor: pointer;
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

/* =====================================================
   APP
===================================================== */

.app {
  display: flex;
  min-height: 100vh;
}

/* =====================================================
   SIDEBAR
===================================================== */

.sidebar {
  position: fixed;
  top: 0;
  left: 0;

  width: 250px;
  height: 100vh;

  display: flex;
  flex-direction: column;

  padding: 26px 18px;

  background:
    rgba(12, 15, 23, 0.96);

  border-right:
    1px solid
    rgba(255, 255, 255, 0.06);

  z-index: 20;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;

  padding:
    0 8px
    28px;
}

.brand-logo {
  width: 43px;
  height: 43px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 13px;

  font-size: 20px;
  font-weight: 800;

  color: white;

  background:
    linear-gradient(
      135deg,
      #5865f2,
      #7c3aed
    );

  box-shadow:
    0 8px 30px
    rgba(88, 101, 242, 0.28);
}

.brand-text h2 {
  font-size: 17px;
  font-weight: 800;
}

.brand-text span {
  display: block;

  margin-top: 3px;

  font-size: 10px;

  color: #777f91;
}

.sidebar-menu {
  display: flex;
  flex-direction: column;

  gap: 7px;
}

.menu-item {
  display: flex;
  align-items: center;

  gap: 13px;

  padding:
    13px 14px;

  border-radius: 10px;

  color: #7e8698;

  font-size: 13px;
  font-weight: 600;

  transition:
    0.2s ease;
}

.menu-item span {
  width: 20px;

  font-size: 16px;

  text-align: center;
}

.menu-item.active {
  color: white;

  background:
    linear-gradient(
      90deg,
      rgba(88, 101, 242, 0.2),
      rgba(88, 101, 242, 0.05)
    );

  border:
    1px solid
    rgba(88, 101, 242, 0.16);
}

.menu-item:hover {
  color: white;

  background:
    rgba(255, 255, 255, 0.04);
}

.sidebar-bottom {
  margin-top: auto;
}

.system-status {
  display: flex;
  align-items: center;

  gap: 10px;

  padding:
    13px;

  border-radius: 12px;

  background:
    rgba(255, 255, 255, 0.025);

  border:
    1px solid
    rgba(255, 255, 255, 0.05);
}

.status-dot {
  width: 8px;
  height: 8px;

  border-radius: 50%;
}

.status-dot.online {
  background: #22c55e;

  box-shadow:
    0 0 12px
    rgba(34, 197, 94, 0.8);
}

.status-dot.offline {
  background: #ef4444;
}

.system-status strong {
  display: block;

  font-size: 11px;
}

.system-status small {
  display: block;

  margin-top: 2px;

  color: #747c8e;

  font-size: 10px;
}

.copyright {
  margin-top: 18px;

  text-align: center;

  color: #4e5565;

  font-size: 9px;
}

/* =====================================================
   MAIN
===================================================== */

.main {
  width: calc(
    100% - 250px
  );

  margin-left: 250px;

  min-height: 100vh;

  padding:
    42px
    48px;
}

/* =====================================================
   TOPBAR
===================================================== */

.topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 30px;
}

.breadcrumb {
  margin-bottom: 8px;

  color: #657087;

  font-size: 11px;
  font-weight: 600;
}

.topbar h1 {
  font-size: 28px;
  font-weight: 800;

  letter-spacing: -0.8px;
}

.topbar p {
  margin-top: 7px;

  color: #737b8e;

  font-size: 12px;
}

.refresh-button {
  display: flex;
  align-items: center;

  gap: 8px;

  padding:
    10px 15px;

  color: #cbd2df;

  background:
    #121620;

  border:
    1px solid
    rgba(255, 255, 255, 0.08);

  border-radius: 9px;

  font-size: 11px;
  font-weight: 600;

  transition:
    0.2s ease;
}

.refresh-button:hover {
  background:
    #181d29;

  border-color:
    rgba(255, 255, 255, 0.14);
}

.refresh-button span {
  font-size: 17px;
}

.rotate {
  display: inline-block;

  animation:
    rotate 0.8s
    linear infinite;
}

@keyframes rotate {
  to {
    transform:
      rotate(360deg);
  }
}

/* =====================================================
   MESSAGE
===================================================== */

.global-message {
  display: flex;
  align-items: center;

  gap: 10px;

  margin-bottom: 20px;

  padding:
    12px 15px;

  border-radius: 10px;

  font-size: 11px;
  font-weight: 600;

  border:
    1px solid
    rgba(255, 255, 255, 0.06);
}

.global-message span {
  width: 20px;
  height: 20px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  font-weight: 800;
}

.global-message.info {
  color: #93c5fd;

  background:
    rgba(59, 130, 246, 0.08);
}

.global-message.info span {
  background:
    rgba(59, 130, 246, 0.2);
}

.global-message.success {
  color: #86efac;

  background:
    rgba(34, 197, 94, 0.08);
}

.global-message.success span {
  background:
    rgba(34, 197, 94, 0.2);
}

.global-message.error {
  color: #fca5a5;

  background:
    rgba(239, 68, 68, 0.08);
}

.global-message.error span {
  background:
    rgba(239, 68, 68, 0.2);
}

/* =====================================================
   STATUS GRID
===================================================== */

.status-grid {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 15px;

  margin-bottom: 22px;
}

.status-card {
  padding:
    20px;

  border-radius: 15px;

  background:
    rgba(16, 20, 30, 0.75);

  border:
    1px solid
    rgba(255, 255, 255, 0.06);

  box-shadow:
    0 15px 40px
    rgba(0, 0, 0, 0.12);
}

.status-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.card-label {
  color: #687286;

  font-size: 9px;
  font-weight: 700;

  letter-spacing: 1px;
}

.status-card h3 {
  margin-top: 7px;

  font-size: 19px;
}

.card-icon {
  width: 34px;
  height: 34px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 10px;

  font-size: 15px;
}

.card-icon.green {
  color: #4ade80;

  background:
    rgba(34, 197, 94, 0.1);
}

.card-icon.red {
  color: #f87171;

  background:
    rgba(239, 68, 68, 0.1);
}

.card-icon.yellow {
  color: #facc15;

  background:
    rgba(234, 179, 8, 0.1);
}

.card-icon.blue {
  color: #60a5fa;

  background:
    rgba(59, 130, 246, 0.1);
}

.connection-status {
  display: flex;
  align-items: center;

  gap: 7px;

  margin-top: 19px;

  color: #737c8f;

  font-size: 9px;
  font-weight: 700;
}

.connection-status span {
  width: 6px;
  height: 6px;

  border-radius: 50%;
}

.connection-status.online {
  color: #4ade80;
}

.connection-status.online span {
  background: #22c55e;
}

.connection-status.offline {
  color: #f87171;
}

.connection-status.offline span {
  background: #ef4444;
}

.connection-status.waiting {
  color: #facc15;
}

.connection-status.waiting span {
  background: #eab308;
}

.connection-status.neutral span {
  background: #64748b;
}

/* =====================================================
   CONTENT CARD
===================================================== */

.content-card {
  margin-bottom: 22px;

  padding:
    26px;

  border-radius: 16px;

  background:
    rgba(16, 20, 30, 0.75);

  border:
    1px solid
    rgba(255, 255, 255, 0.06);
}

.section-heading {
  display: flex;
  align-items: flex-start;

  gap: 15px;

  margin-bottom: 24px;
}

.section-number {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 30px;
  height: 30px;

  flex-shrink: 0;

  border-radius: 8px;

  color: #818cf8;

  background:
    rgba(99, 102, 241, 0.1);

  font-size: 10px;
  font-weight: 800;
}

.section-heading h2 {
  font-size: 17px;
}

.section-heading p {
  margin-top: 6px;

  color: #6f788b;

  font-size: 11px;
}

/* =====================================================
   PAIRING FORM
===================================================== */

.pairing-form {
  display: flex;

  gap: 10px;
}

.phone-input {
  flex: 1;

  display: flex;
  align-items: center;

  height: 48px;

  padding:
    0 15px;

  border-radius: 10px;

  background:
    #0b0e15;

  border:
    1px solid
    rgba(255, 255, 255, 0.08);
}

.phone-input span {
  padding-right: 12px;

  color: #818a9d;

  font-size: 12px;
  font-weight: 700;

  border-right:
    1px solid
    rgba(255, 255, 255, 0.08);
}

.phone-input input {
  width: 100%;

  padding-left: 12px;

  color: white;

  background: transparent;

  border: 0;
  outline: 0;

  font-size: 12px;
}

.phone-input input::placeholder {
  color: #454d5c;
}

.pair-button {
  height: 48px;

  padding:
    0 20px;

  display: flex;
  align-items: center;

  gap: 12px;

  color: white;

  background:
    linear-gradient(
      135deg,
      #5865f2,
      #7c3aed
    );

  border-radius: 10px;

  font-size: 11px;
  font-weight: 700;

  box-shadow:
    0 8px 25px
    rgba(88, 101, 242, 0.18);
}

.pair-button span {
  font-size: 17px;
}

.pair-button:hover {
  filter:
    brightness(1.1);
}

/* =====================================================
   SPINNER
===================================================== */

.spinner {
  width: 15px;
  height: 15px;

  display: inline-block;

  border:
    2px solid
    rgba(255, 255, 255, 0.3);

  border-top-color:
    white;

  border-radius: 50%;

  animation:
    rotate 0.7s
    linear infinite;
}

.spinner.dark {
  border-color:
    rgba(255, 255, 255, 0.1);

  border-top-color:
    #818cf8;
}

/* =====================================================
   PAIRING RESULT
===================================================== */

.pairing-result {
  margin-top: 22px;

  padding: 22px;

  border-radius: 14px;

  background:
    linear-gradient(
      135deg,
      rgba(34, 197, 94, 0.06),
      rgba(88, 101, 242, 0.05)
    );

  border:
    1px solid
    rgba(34, 197, 94, 0.14);

  text-align: center;
}

.pairing-result-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  text-align: left;
}

.success-label {
  color: #4ade80;

  font-size: 9px;
  font-weight: 800;

  letter-spacing: 1px;
}

.pairing-result h3 {
  margin-top: 6px;

  color: #e5e7eb;

  font-size: 14px;
}

.success-icon {
  width: 32px;
  height: 32px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  color: #4ade80;

  background:
    rgba(34, 197, 94, 0.12);

  font-weight: 800;
}

.pairing-code {
  width: 100%;

  margin-top: 20px;

  padding:
    17px;

  color: white;

  background:
    #080b11;

  border:
    1px dashed
    rgba(129, 140, 248, 0.5);

  border-radius: 10px;

  font-size: 22px;
  font-weight: 800;

  letter-spacing: 5px;

  text-align: center;

  cursor: pointer;

  transition:
    0.2s ease;
}

.pairing-code:hover {
  background:
    #0e121c;

  border-color:
    #818cf8;
}

.copy-button {
  width: 100%;

  margin-top: 10px;

  padding:
    12px;

  color: #c7d2fe;

  background:
    rgba(99, 102, 241, 0.1);

  border:
    1px solid
    rgba(99, 102, 241, 0.2);

  border-radius: 9px;

  font-size: 11px;
  font-weight: 700;
}

.copy-button:hover {
  background:
    rgba(99, 102, 241, 0.17);
}

.pairing-instruction {
  display: flex;
  align-items: center;
  justify-content: center;

  flex-wrap: wrap;

  gap: 8px;

  margin-top: 18px;

  color: #70798c;

  font-size: 10px;
}

.pairing-instruction span {
  width: 20px;
  height: 20px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  color: #a5b4fc;

  background:
    rgba(99, 102, 241, 0.12);

  font-size: 9px;
  font-weight: 800;
}

.pairing-session {
  display: block;

  margin-top: 14px;

  color: #4f586a;

  font-size: 9px;
}

/* =====================================================
   SESSION HEADING
===================================================== */

.session-heading {
  align-items: center;

  justify-content: space-between;
}

.section-heading-left {
  display: flex;
  gap: 15px;
}

.session-total {
  display: flex;
  flex-direction: column;

  align-items: center;

  min-width: 55px;
}

.session-total strong {
  color: #818cf8;

  font-size: 22px;
}

.session-total span {
  margin-top: 3px;

  color: #626b7c;

  font-size: 9px;
}

/* =====================================================
   EMPTY STATE
===================================================== */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;

  padding:
    45px 20px;

  text-align: center;
}

.empty-icon {
  width: 48px;
  height: 48px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 15px;

  border-radius: 14px;

  color: #667085;

  background:
    rgba(255, 255, 255, 0.04);

  font-size: 20px;
}

.empty-state h3 {
  font-size: 14px;
}

.empty-state p {
  margin-top: 7px;

  color: #626b7b;

  font-size: 11px;
}

/* =====================================================
   SESSION LIST
===================================================== */

.session-list {
  display: flex;
  flex-direction: column;

  gap: 10px;
}

.session-item {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;

  padding:
    14px;

  border-radius: 12px;

  background:
    rgba(255, 255, 255, 0.025);

  border:
    1px solid
    rgba(255, 255, 255, 0.05);
}

.session-left {
  display: flex;
  align-items: center;

  gap: 12px;

  min-width: 0;
}

.session-avatar {
  width: 40px;
  height: 40px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 11px;

  color: white;

  background:
    linear-gradient(
      135deg,
      #5865f2,
      #7c3aed
    );

  font-weight: 800;
}

.session-left h3 {
  font-size: 12px;
}

.session-left p {
  margin-top: 5px;

  color: #687286;

  font-size: 10px;
}

.session-right {
  display: flex;
  align-items: center;

  gap: 10px;
}

.session-badge {
  display: flex;
  align-items: center;

  gap: 6px;

  padding:
    6px 9px;

  border-radius: 20px;

  font-size: 9px;
  font-weight: 700;
}

.session-badge span {
  width: 5px;
  height: 5px;

  border-radius: 50%;
}

.session-badge.connected {
  color: #4ade80;

  background:
    rgba(34, 197, 94, 0.08);
}

.session-badge.connected span {
  background:
    #22c55e;
}

.session-badge.disconnected {
  color: #f87171;

  background:
    rgba(239, 68, 68, 0.08);
}

.session-badge.disconnected span {
  background:
    #ef4444;
}

.logout-button {
  padding:
    7px 11px;

  color: #f87171;

  background:
    rgba(239, 68, 68, 0.06);

  border:
    1px solid
    rgba(239, 68, 68, 0.12);

  border-radius: 7px;

  font-size: 9px;
  font-weight: 700;
}

.logout-button:hover {
  background:
    rgba(239, 68, 68, 0.12);
}

/* =====================================================
   FOOTER
===================================================== */

.footer {
  display: flex;
  justify-content: space-between;

  padding:
    8px 2px 25px;

  color: #454d5d;

  font-size: 9px;
}

/* =====================================================
   MODAL
===================================================== */

.modal-overlay {
  position: fixed;

  inset: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 20px;

  background:
    rgba(0, 0, 0, 0.72);

  backdrop-filter:
    blur(8px);

  z-index: 100;
}

.logout-modal {
  position: relative;

  width: 100%;
  max-width: 400px;

  padding: 30px;

  border-radius: 18px;

  background:
    #11151f;

  border:
    1px solid
    rgba(255, 255, 255, 0.08);

  box-shadow:
    0 30px 80px
    rgba(0, 0, 0, 0.45);

  text-align: center;
}

.modal-close {
  position: absolute;

  top: 15px;
  right: 15px;

  width: 30px;
  height: 30px;

  border-radius: 8px;

  color: #778092;

  background:
    rgba(255, 255, 255, 0.04);

  font-size: 20px;
}

.warning-icon {
  width: 45px;
  height: 45px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin:
    0 auto 15px;

  border-radius: 13px;

  color: #f87171;

  background:
    rgba(239, 68, 68, 0.1);

  font-size: 20px;
  font-weight: 800;
}

.logout-modal h2 {
  font-size: 18px;
}

.logout-modal > p {
  margin-top: 8px;

  color: #70798a;

  font-size: 11px;

  line-height: 1.6;
}

.target-session {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-top: 20px;

  padding:
    12px;

  border-radius: 9px;

  background:
    rgba(255, 255, 255, 0.03);
}

.target-session span {
  color: #626b7b;

  font-size: 9px;
  font-weight: 700;
}

.target-session strong {
  color: #cbd5e1;

  font-size: 11px;
}

.logout-input {
  width: 100%;

  height: 45px;

  margin-top: 10px;

  padding:
    0 13px;

  color: white;

  background:
    #0b0e15;

  border:
    1px solid
    rgba(255, 255, 255, 0.08);

  border-radius: 9px;

  outline: none;

  font-size: 12px;
}

.logout-input:focus {
  border-color:
    rgba(99, 102, 241, 0.6);
}

.modal-buttons {
  display: flex;

  gap: 10px;

  margin-top: 15px;
}

.modal-buttons button {
  flex: 1;

  height: 43px;

  border-radius: 9px;

  font-size: 11px;
  font-weight: 700;
}

.cancel-button {
  color: #aab2c0;

  background:
    rgba(255, 255, 255, 0.05);
}

.confirm-button {
  color: white;

  background:
    #dc2626;
}

.confirm-button:hover {
  background:
    #ef4444;
}

/* =====================================================
   RESPONSIVE TABLET
===================================================== */

@media (
  max-width: 1000px
) {

  .sidebar {
    width: 210px;
  }

  .main {
    width: calc(
      100% - 210px
    );

    margin-left: 210px;

    padding:
      30px;
  }

  .status-grid {
    grid-template-columns:
      1fr;
  }

}

/* =====================================================
   RESPONSIVE MOBILE
===================================================== */

@media (
  max-width: 700px
) {

  .app {
    display: block;
  }

  .sidebar {
    position: relative;

    width: 100%;
    height: auto;

    padding:
      15px;

    border-right: 0;

    border-bottom:
      1px solid
      rgba(255, 255, 255, 0.06);
  }

  .brand {
    padding:
      0 3px
      12px;
  }

  .sidebar-menu {
    display: none;
  }

  .sidebar-bottom {
    display: none;
  }

  .main {
    width: 100%;

    margin-left: 0;

    padding:
      24px 15px;
  }

  .topbar {
    flex-direction: column;
  }

  .topbar h1 {
    font-size: 24px;
  }

  .refresh-button {
    width: 100%;

    justify-content: center;
  }

  .status-grid {
    grid-template-columns:
      1fr;
  }

  .content-card {
    padding:
      18px;
  }

  .pairing-form {
    flex-direction: column;
  }

  .pair-button {
    width: 100%;

    justify-content: center;
  }

  .session-heading {
    align-items: flex-start;
  }

  .session-item {
    align-items: flex-start;

    flex-direction: column;
  }

  .session-right {
    width: 100%;

    justify-content: space-between;
  }

  .session-badge {
    flex: 1;

    justify-content: center;
  }

  .logout-button {
    padding:
      8px 15px;
  }

  .footer {
    flex-direction: column;

    gap: 7px;
  }

  .pairing-code {
    font-size: 18px;

    letter-spacing: 3px;
  }

  .pairing-instruction {
    flex-direction: column;

    align-items: center;
  }

}

/* =====================================================
   SMALL MOBILE
===================================================== */

@media (
  max-width: 380px
) {

  .main {
    padding:
      20px 12px;
  }

  .content-card {
    padding:
      15px;
  }

  .pairing-result {
    padding:
      15px;
  }

  .logout-modal {
    padding:
      24px 18px;
  }

}
